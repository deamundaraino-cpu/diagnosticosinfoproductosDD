# ============================================================
# Plataforma de Diagnóstico Daviddigital — variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Sin Supabase la app corre en "modo demo" (no persiste datos).
# ============================================================

# --- Supabase (necesario para persistir diagnósticos) ---
# Crear proyecto gratis en https://supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (opcional: envío del roadmap por email) ---
# https://resend.com → API Keys. Sin key, la app no envía email (solo lo registra en logs).
RESEND_API_KEY=
# Remitente verificado en Resend (ej. "Daviddigital <hola@tudominio.com>")
EMAIL_FROM=

# --- MailerLite (opcional: nurture / email marketing) ---
# https://mailerlite.com → Integrations → API. Sin key, los leads quedan
# solo en Supabase. Los IDs de grupo los imprime: npm run setup:mailerlite
MAILERLITE_API_KEY=
MAILERLITE_GROUP_A=
MAILERLITE_GROUP_B=

# --- PostHog (opcional: analytics de eventos del quiz) ---
# https://posthog.com → Project Settings. Sin key, no se envían eventos.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Meta: Pixel + API de Conversiones (opcional) ---
# Events Manager → tu dataset. El mismo ID va en las dos variables:
# la NEXT_PUBLIC_ la usa el pixel del navegador, la otra el servidor.
# Sin ellas no se envía nada a Meta y el resto sigue funcionando igual.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
# Events Manager → Configuración → API de conversiones → Generar token
META_CAPI_TOKEN=
# Opcional: código del probador de eventos, para verificar sin ensuciar
# los datos reales. Events Manager → Probar eventos. QUITAR en producción.
META_TEST_EVENT_CODE=
# Opcional: versión de la Graph API (por defecto v23.0)
META_API_VERSION=

# --- Bloque final del resultado ---
# URL del sistema de agendamiento (Calendly, Cal.com, TidyCal...). Se le
# añade ?diagnostico=<id> para cruzar cada llamada con sus respuestas.
# Sin esta variable el bloque cae al enlace de Instagram, nunca a un
# botón roto.
NEXT_PUBLIC_URL_AGENDAMIENTO=
# Escalera de productos: apagada durante la fase de investigación de
# mercado. Ponerla en "true" reactiva la recomendación fase/tag → producto
# en la web y en el correo.
NEXT_PUBLIC_RECOMENDACION_PRODUCTO=false

# --- Cron de barrido de abandonos ---
# Cualquier cadena larga y aleatoria. Vercel la manda como Bearer token
# al ejecutar el cron definido en vercel.json.
CRON_SECRET=

# --- Panel /admin ---
ADMIN_PASSWORD=cambia-esta-password

# --- URL pública del sitio (para links en el email) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mostrar badge "texto provisional" sobre los roadmaps placeholder ---
NEXT_PUBLIC_SHOW_PLACEHOLDER_BADGE=true
